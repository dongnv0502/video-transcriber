# AWS Video Transcriber Configuration
# LLM endpoint settings (OpenAI-compatible HTTP endpoint)
# e.g., OpenAI, Ollama (/v1), vLLM, OpenRouter, etc.
TRANSCRIBER_LLM_BASE_URL=https://api.openai.com/v1
TRANSCRIBER_LLM_API_KEY=your-api-key-here
TRANSCRIBER_LLM_MODEL=gpt-4o-mini
TRANSCRIBER_LLM_ENABLED=true

# Override directories if needed (defaults shown below)
# TRANSCRIBER_VIDEO_DIR=./videos
# TRANSCRIBER_OUTPUT_DIR=./output
# TRANSCRIBER_WORK_DIR=./work
# TRANSCRIBER_LOG_DIR=./logs
# TRANSCRIBER_DB_PATH=./state.db

# Whisper ASR model
# TRANSCRIBER_MODEL_NAME=mlx-community/whisper-large-v3-mlx
# TRANSCRIBER_LANGUAGE=vi
